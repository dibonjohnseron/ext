function Get-FileSizeMB($path) {
    if (Test-Path -LiteralPath $path -PathType Leaf) {
        return [math]::Round((Get-Item -LiteralPath $path).Length / 1MB, 2)
    }
    return $null
}

$ubuntuVhdxPath = Get-ChildItem "HKCU:\Software\Microsoft\Windows\CurrentVersion\Lxss" | ForEach-Object {
    $props = Get-ItemProperty -Path $_.PSPath
    if ($props.DistributionName -and $props.DistributionName.ToLower().Contains("ubuntu")) {
        return (Join-Path $props.BasePath "ext4.vhdx")
    }
} | Select-Object -First 1

if (-not $ubuntuVhdxPath) {
    throw "Ubuntu VHDX path not found."
}

$dockerVhdxPath = if ($env:DOCKER_VHDX_PATH) {
    $env:DOCKER_VHDX_PATH
} else {
    Join-Path $env:LOCALAPPDATA "Docker\wsl\disk\docker_data.vhdx"
}

$disks = @(@{ Name = "Ubuntu"; Path = $ubuntuVhdxPath })
if (Test-Path -LiteralPath $dockerVhdxPath -PathType Leaf) {
    $disks += @{ Name = "Docker"; Path = $dockerVhdxPath }
} elseif ($env:DOCKER_VHDX_PATH) {
    throw "Docker VHDX file not found at configured path: $dockerVhdxPath"
} else {
    Write-Warning "Docker VHDX not found at $dockerVhdxPath. Set DOCKER_VHDX_PATH if it is stored elsewhere; Docker will be skipped."
}

if (Get-Process -Name "Docker Desktop", "com.docker.backend" -ErrorAction SilentlyContinue) {
    throw "Quit Docker Desktop completely before running this script."
}

foreach ($disk in $disks) {
    $disk.SizeBefore = Get-FileSizeMB $disk.Path
    if ($null -eq $disk.SizeBefore) {
        throw "$($disk.Name) VHDX file not found at path: $($disk.Path)"
    }
    if ($disk.Path -match '["\r\n]') {
        throw "Invalid VHDX path: $($disk.Path)"
    }
    Write-Host "$($disk.Name) VHDX: $($disk.Path) ($($disk.SizeBefore) MB)"
}

Write-Host "Shutting down WSL..."
wsl --shutdown
if ($LASTEXITCODE -ne 0) {
    throw "WSL shutdown failed with exit code $LASTEXITCODE."
}

$diskpartCommands = foreach ($disk in $disks) {
    "select vdisk file=`"$($disk.Path)`""
    "attach vdisk readonly"
    "compact vdisk"
    "detach vdisk"
}
$diskpartCommands += "exit"

$scriptPath = [System.IO.Path]::GetTempFileName()
try {
    $diskpartCommands | Out-File -LiteralPath $scriptPath -Encoding Unicode
    Write-Host "Compacting VHDX files with DiskPart. This may take a while..."
    diskpart /s $scriptPath
    if ($LASTEXITCODE -ne 0) {
        throw "DiskPart failed with exit code $LASTEXITCODE. A VHDX may still be attached read-only; check Disk Management before retrying."
    }
} finally {
    Remove-Item -LiteralPath $scriptPath -ErrorAction Stop
}

$totalSaved = 0
foreach ($disk in $disks) {
    $sizeAfter = Get-FileSizeMB $disk.Path
    if ($null -eq $sizeAfter) {
        throw "$($disk.Name) VHDX file not found after compacting: $($disk.Path)"
    }
    $spaceSaved = [math]::Round($disk.SizeBefore - $sizeAfter, 2)
    $totalSaved += $spaceSaved
    Write-Host "$($disk.Name): $sizeAfter MB after compacting; $spaceSaved MB saved."
}
Write-Host "Total space saved: $([math]::Round($totalSaved, 2)) MB"
